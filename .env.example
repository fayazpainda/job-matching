# Copy this file to .env and fill in your API key
# 复制此文件为 .env 并填写你的 API Key

# Qwen / Alibaba Cloud DashScope (OpenAI-compatible)
# Get a free key from: https://bailian.console.aliyun.com/  (开通后在 API-KEY 页面创建)
DASHSCOPE_API_KEY=sk-your-key-here

# Optional: API endpoint (use the -intl host if outside mainland China)
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional: override the default model
# LLM_MODEL=qwen-plus
# LLM_MODEL=qwen-turbo
# LLM_MODEL=qwen-max
